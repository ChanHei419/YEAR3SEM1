<Window x:Class="TaikoGame.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Taiko Game" Height="720" Width="1280" 
        WindowState="Maximized" Background="Black">
    <Grid>
        <Canvas x:Name="GameCanvas" Background="#1a1a1a"/>
        
        <StackPanel x:Name="TopRightPanel" VerticalAlignment="Top" HorizontalAlignment="Right" Margin="20">
            <TextBlock x:Name="RoomIdText" 
                       FontSize="16" 
                       Foreground="Lime" 
                       Margin="0,0,0,10"
                       Text="Room ID: "/>
            <TextBlock x:Name="JudgmentText" 
                       FontSize="48" 
                       Foreground="Gold" 
                       TextAlignment="Center"
                       Margin="0,20,0,0"
                       Text=""/>
        </StackPanel>

        <StackPanel VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,30">
            <TextBlock x:Name="ProgressText" 
                       FontSize="16" 
                       Foreground="White" 
                       TextAlignment="Center"
                       Margin="0,0,0,10"
                       Text="0% / 0:00"/>
            <ProgressBar x:Name="ProgressBar" 
                         Width="400" 
                         Height="20" 
                         Foreground="LimeGreen" 
                         Background="DarkGray"
                         Margin="0,0,0,10"/>
        </StackPanel>

        
    </Grid>
</Window>